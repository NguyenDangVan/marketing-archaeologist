{
  "name": "marketing-archaeologist",
  "version": "0.0.0",
  "description": "Reverse engineer marketing in a niche from public evidence and turn it into evidence-backed playbooks.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "bin": {
    "marc": "dist/cli/index.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "marc": "tsx src/cli/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "schemas": "tsx scripts/gen-schemas.ts",
    "schemas:check": "tsx scripts/gen-schemas.ts --check"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
