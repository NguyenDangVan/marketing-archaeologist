{
  "$id": "https://raw.githubusercontent.com/NguyenDangVan/marketing-archaeologist/main/schemas/evidence.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^ev_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "niche": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "brand_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^brand_[a-z0-9_]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "source": {
      "type": "string",
      "enum": [
        "website",
        "youtube",
        "meta_ad_library",
        "facebook_page",
        "tiktok",
        "shopee",
        "tiktok_shop",
        "lazada",
        "instagram",
        "threads",
        "google_maps",
        "press",
        "dark_channel"
      ]
    },
    "dark_channel": {
      "type": "string",
      "minLength": 1
    },
    "evidence_class": {
      "default": "primary",
      "type": "string",
      "enum": [
        "primary",
        "secondary"
      ]
    },
    "kind": {
      "type": "string",
      "enum": [
        "ad",
        "post",
        "video",
        "page",
        "comment_batch",
        "pricing",
        "product_listing",
        "review_batch",
        "article"
      ]
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "collected_by": {
      "type": "string",
      "pattern": "^([a-z0-9_-]+@\\d+\\.\\d+\\.\\d+|manual(:\\S+)?)$"
    },
    "snapshot_path": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "published_at": {
      "default": null,
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "string",
              "format": "date",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
            },
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "text": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "items": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "metrics": {
      "default": {},
      "type": "object",
      "properties": {
        "views": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "reactions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "likes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "comments": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "shares": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "ad_started_running": {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        },
        "sold_count_display": {
          "type": "string",
          "minLength": 1
        },
        "sold_count_min": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "rating": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        },
        "rating_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "price_vnd": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    "raw": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    }
  },
  "required": [
    "id",
    "niche",
    "brand_id",
    "source",
    "kind",
    "url",
    "observed_at",
    "collected_by",
    "snapshot_path",
    "content_hash"
  ]
}
