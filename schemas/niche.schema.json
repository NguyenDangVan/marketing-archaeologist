{
  "$id": "https://raw.githubusercontent.com/NguyenDangVan/marketing-archaeologist/main/schemas/niche.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "market": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "timezone": {
      "default": "Asia/Ho_Chi_Minh",
      "type": "string",
      "minLength": 1
    },
    "language": {
      "default": "vi",
      "type": "string",
      "minLength": 2
    },
    "channels": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "website",
          "youtube",
          "meta_ad_library",
          "facebook_page",
          "tiktok",
          "shopee",
          "tiktok_shop",
          "lazada",
          "instagram",
          "threads",
          "google_maps"
        ]
      }
    },
    "dark_channels": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "analysis": {
      "default": {},
      "type": "object",
      "properties": {
        "baseline_window": {
          "default": 30,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "outlier_multiplier": {
          "default": 3,
          "type": "number",
          "exclusiveMinimum": 1
        },
        "long_running_ad_days": {
          "default": 30,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      }
    }
  },
  "required": [
    "id",
    "name",
    "market",
    "channels"
  ]
}
